---
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="crumbs">
  <ol role="list">
    {items.map((c, i) => (
      <li>
        {c.href && i < items.length - 1 ? (
          <a class="link" href={c.href}>
            {c.label}
          </a>
        ) : (
          <span aria-current="page">{c.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    font-size: var(--fs-small);
    font-weight: 500;
  }

  .crumbs li + li::before {
    content: '/';
    margin-inline-end: var(--space-2);
    opacity: 0.7;
  }

  .crumbs a {
    text-decoration: none;
  }
</style>
