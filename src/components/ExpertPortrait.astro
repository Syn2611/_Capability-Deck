---
import { Picture } from 'astro:assets';
import { imageOpts } from '../lib/image-opts';
import Icon from './Icon.astro';
import type { Expert } from '../data/experts';

interface Props {
  expert: Expert;
  size?: number;
}
const { expert, size = 220 } = Astro.props;
---

<span class="portrait" style={`--size:${size}px`}>
  {expert.photo ? (
    <Picture
      src={expert.photo}
      alt=""
      {...imageOpts([size, Math.min(size * 2, expert.photo.width)], expert.photo.width)}
      sizes={`${size}px`}
      loading="lazy"
      quality={80}
      fallbackFormat="webp"
    />
  ) : (
    <span class="portrait__silhouette">
      <Icon name="person" />
    </span>
  )}
</span>

<style>
  .portrait {
    display: block;
    inline-size: min(var(--size), 100%);
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    background: var(--c-pale-blue-grey);
  }

  /* Headshots are cut-outs on transparency: sit them on the same field as the portrait cards */
  .portrait:has(img) {
    background: var(--c-portrait);
  }

  .portrait :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 50% 0;
    scale: 1.35;
    transform-origin: 50% 6%;
  }

  .portrait__silhouette {
    display: grid;
    place-items: center;
    block-size: 100%;
    color: var(--c-medium-blue-grey);
    --icon-size: 46%;
    --icon-stroke: 0.9;
  }
</style>
