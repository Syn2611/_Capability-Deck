---
/** "Content pending" marker — rendered in dev builds only; production renders nothing. */
interface Props {
  label?: string;
  class?: string;
}
const { label = 'Content pending', class: cls } = Astro.props;
const show = import.meta.env.DEV;
---

{show && (
  <div class:list={['pending', cls]} role="note">
    {label}
  </div>
)}
