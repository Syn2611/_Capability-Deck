---
import { icons, type IconName } from './icons';

interface Props {
  name: IconName;
  /** Accessible label. Omit for decorative icons. */
  label?: string;
  class?: string;
}

const { name, label, class: cls } = Astro.props;
const extra = name.startsWith('arrow') ? ' icon--arrow' : '';
---

<svg
  class={`icon icon--${name}${extra}${cls ? ` ${cls}` : ''}`}
  viewBox="0 0 24 24"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={icons[name]}
/>
