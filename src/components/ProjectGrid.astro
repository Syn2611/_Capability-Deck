---
import ProjectCard from './ProjectCard.astro';
import type { Project } from '../data/projects';

interface Props {
  projects: Project[];
  filterable?: boolean;
  /** On phones, how many show before "Show all" (filterable lists only). */
  previewCount?: number;
}
const { projects, filterable = false, previewCount = Infinity } = Astro.props;
---

<ul class="project-grid" role="list" data-filter-grid>
  {projects.map((p, i) => (
    <ProjectCard project={p} filterable={filterable} extra={filterable && i >= previewCount} />
  ))}
</ul>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-8) var(--gutter);
    margin: 0;
    padding: 0;
    transition: opacity 250ms var(--ease-out);
  }

  .project-grid.is-fading {
    opacity: 0;
  }

  @media (max-width: 1023px) {
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 599px) {
    .project-grid {
      grid-template-columns: 1fr;
      row-gap: 0;
    }

    .project-grid > :global(.project) {
      padding-block: var(--space-4);
      border-block-end: 1px solid var(--keyline);
    }

    .project-grid > :global(.project:first-child) {
      padding-block-start: 0;
    }
  }
</style>
