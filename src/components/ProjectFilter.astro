---
import ProjectGrid from './ProjectGrid.astro';
import { projectFilters, filterGroupOf, type Project } from '../data/projects';

interface Props {
  projects: Project[];
}
const { projects } = Astro.props;
const filters = projectFilters.filter(
  (f) => f.id === 'all' || projects.some((p) => filterGroupOf(p) === f.id),
);
---

<div class="pf" data-project-filter>
  <div class="pf__bar">
    <div class="pf__pills" role="group" aria-label="Filter track record by sector">
      {filters.map((f, i) => (
        <button class="pf__pill" type="button" data-filter={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>
          {f.label}
        </button>
      ))}
    </div>
    <p class="pf__status" aria-live="polite" data-filter-status>
      Showing all {projects.length} engagements
    </p>
  </div>
  <ProjectGrid projects={projects} filterable />
</div>

<style>
  .pf__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4) var(--gutter);
    margin-block-end: var(--space-8);
  }

  .pf__pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .pf__pill {
    min-block-size: var(--tap);
    padding: 0 var(--space-5);
    border-radius: var(--r-pill);
    border: 1px solid var(--c-pale-blue-grey);
    background: var(--c-white);
    color: var(--c-deep-blue);
    font-size: var(--fs-small);
    font-weight: 500;
    transition:
      background-color var(--dur-hover) var(--ease-out),
      border-color var(--dur-hover) var(--ease-out),
      color var(--dur-hover) var(--ease-out);
  }

  .pf__pill:hover {
    border-color: var(--c-light-blue-grey);
  }

  .pf__pill[aria-pressed='true'] {
    background: var(--c-deep-blue);
    border-color: var(--c-deep-blue);
    color: var(--c-white);
  }

  .pf__status {
    font-size: var(--fs-small);
    color: var(--fg-muted);
  }

  @media (max-width: 599px) {
    .pf__pills {
      flex-wrap: nowrap;
      overflow-x: auto;
      margin-inline: calc(-1 * var(--page-margin));
      padding-inline: var(--page-margin);
      scrollbar-width: none;
    }

    .pf__pill {
      flex: none;
    }
  }
</style>
