---
import ExpertPortrait from './ExpertPortrait.astro';
import Icon from './Icon.astro';
import type { Expert } from '../data/experts';
import { telHref } from '../lib/url';

interface Props {
  expert: Expert;
}
const { expert: e } = Astro.props;
const titleId = `expert-${e.id}-name`;
---

<dialog class="xd" id={`expert-${e.id}`} aria-labelledby={titleId} data-expert-dialog>
  <div class="xd__panel">
    <button class="xd__close" type="button" data-dialog-close>
      <span class="sr-only">Close</span>
      <Icon name="close" />
    </button>
    <div class="xd__head">
      <ExpertPortrait expert={e} size={140} />
      <div>
        <h3 class="xd__name" id={titleId}>
          {e.name}
        </h3>
        <p class="xd__title">{e.title}</p>
        {e.team && <p class="xd__team">{e.team}</p>}
      </div>
    </div>
    {e.bio && <p class="xd__bio">{e.bio}</p>}
    {e.note && <p class="xd__note">{e.note}</p>}
    {(e.phone || e.email) && (
      <ul class="xd__contact" role="list">
        {e.phone && (
          <li>
            <a class="btn btn--outline" href={telHref(e.phone)}>
              <Icon name="phone" />
              <span class="t-num">{e.phone}</span>
            </a>
          </li>
        )}
        {e.email && (
          <li>
            <a class="btn" href={`mailto:${e.email}`}>
              <Icon name="mail" />
              {e.email}
            </a>
          </li>
        )}
      </ul>
    )}
  </div>
</dialog>

<style>
  .xd {
    inline-size: min(640px, calc(100vw - 2 * var(--page-margin)));
    max-block-size: calc(100dvh - 2 * var(--space-6));
    padding: 0;
    border: 0;
    border-radius: var(--r-card);
    background: var(--c-white);
    color: var(--c-deep-blue);
    box-shadow: var(--shadow);
    opacity: 0;
    translate: 0 12px;
    transition:
      opacity 300ms var(--ease-out),
      translate 300ms var(--ease-out),
      display 300ms allow-discrete,
      overlay 300ms allow-discrete;
  }

  .xd[open] {
    opacity: 1;
    translate: 0 0;
  }

  @starting-style {
    .xd[open] {
      opacity: 0;
      translate: 0 12px;
    }
  }

  .xd::backdrop {
    background: var(--scrim-deep);
    opacity: 0;
    transition:
      opacity 300ms var(--ease-out),
      display 300ms allow-discrete,
      overlay 300ms allow-discrete;
  }

  .xd[open]::backdrop {
    opacity: 1;
  }

  @starting-style {
    .xd[open]::backdrop {
      opacity: 0;
    }
  }

  .xd__panel {
    position: relative;
    padding: clamp(24px, 5vw, 48px);
  }

  .xd__close {
    position: absolute;
    inset-block-start: var(--space-4);
    inset-inline-end: var(--space-4);
    display: grid;
    place-items: center;
    inline-size: var(--tap);
    block-size: var(--tap);
    border: 1px solid var(--c-pale-blue-grey);
    border-radius: var(--r-pill);
    background: var(--c-white);
  }

  .xd__head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--space-5);
    padding-inline-end: var(--space-8);
  }

  .xd__head :global(.portrait) {
    inline-size: 112px;
  }

  .xd__name {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--fs-h3);
    line-height: 1.25;
  }

  .xd__title {
    margin-block-start: var(--space-2);
    font-weight: 600;
    font-size: var(--fs-small);
  }

  .xd__team {
    font-size: var(--fs-small);
    color: var(--c-deep-blue-grey);
  }

  .xd__bio {
    margin-block-start: var(--space-6);
    padding-block-start: var(--space-6);
    border-block-start: 1px solid var(--c-pale-blue-grey);
  }

  .xd__note {
    margin-block-start: var(--space-4);
    padding-inline-start: var(--space-4);
    border-inline-start: 2px solid var(--c-medium-blue);
    font-size: var(--fs-small);
    color: var(--c-deep-blue-grey);
  }

  .xd__contact {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-6);
  }

  .xd__contact .btn {
    white-space: normal;
    word-break: break-word;
  }

  @media (max-width: 479px) {
    .xd__head {
      grid-template-columns: 1fr;
    }

    .xd__head :global(.portrait) {
      inline-size: 88px;
    }

    .xd__contact .btn {
      inline-size: 100%;
    }
  }
</style>
