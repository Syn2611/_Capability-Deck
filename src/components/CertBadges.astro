---
import { Image } from 'astro:assets';
import { certifications } from '../data/quality';
---

<ul class="certs" role="list" aria-label="Quality methodology and certifications">
  {certifications.map((c) => (
    <li class="cert">
      <span class="cert__logo">
        <Image src={c.logo} alt={c.alt} height={300} densities={[1, 2]} format="webp" loading="lazy" />
      </span>
      <span class="cert__role">{c.role}</span>
    </li>
  ))}
</ul>

<style>
  .certs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gutter);
    margin: 0;
    padding: 0;
  }

  .cert {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: var(--space-6) var(--space-4) var(--space-5);
    border: 1px solid var(--keyline);
    border-radius: var(--r-card);
    background: var(--card-bg);
    text-align: center;
  }

  .cert__logo {
    display: grid;
    place-items: center;
    block-size: 150px;
    margin-block-end: var(--space-5);
  }

  .cert__logo :global(img) {
    inline-size: auto;
    block-size: 150px;
    max-inline-size: 100%;
    object-fit: contain;
  }

  .cert__role {
    font-size: var(--fs-xs);
    color: var(--fg-muted);
  }

  @media (max-width: 767px) {
    .certs {
      gap: var(--space-3);
    }

    .cert {
      padding: var(--space-4) var(--space-2);
    }

    .cert__logo {
      block-size: 88px;
      margin-block-end: var(--space-3);
    }

    .cert__logo :global(img) {
      block-size: 88px;
    }
  }
</style>
