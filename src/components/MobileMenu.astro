---
import logo from '../assets/brand/colliers-logo.svg';
import Icon from './Icon.astro';
import type { Sector } from '../lib/sectors';
import { url } from '../lib/url';

interface Props {
  sectors: Sector[];
  current?: string;
}

const { sectors, current } = Astro.props;
const primary = [
  { label: 'Overview', href: url('/') },
  { label: 'Quality', href: url('/#quality') },
  { label: 'Track Record', href: url('/#track-record') },
  { label: 'Experts', href: url('/#experts') },
  { label: 'Contact', href: url('/contact/') },
];
---

<dialog class="mobile-menu" id="mobile-menu" aria-label="Menu" data-mobile-menu>
  <div class="mobile-menu__bar container">
    <img src={logo.src} width="96" height="55" alt="Colliers" />
    <button class="mobile-menu__close" type="button" data-menu-close>
      <span class="sr-only">Close menu</span>
      <Icon name="close" />
    </button>
  </div>
  <nav class="container mobile-menu__body" aria-label="Mobile">
    <ul class="mobile-menu__primary" role="list">
      {primary.map((l, i) => (
        <li style={`--i:${i}`}>
          <a href={l.href} data-menu-link>
            {l.label}
          </a>
        </li>
      ))}
    </ul>
    <p class="mobile-menu__label" style={`--i:${primary.length}`}>
      Sectors
    </p>
    <ul class="mobile-menu__sectors" role="list">
      {sectors.map((s, i) => (
        <li style={`--i:${primary.length + 1 + i}`}>
          <a
            href={url(`/sectors/${s.id}/`)}
            aria-current={current === s.id ? 'page' : undefined}
            data-menu-link
          >
            {s.data.title}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</dialog>

<style>
  .mobile-menu {
    position: fixed;
    inset: 0;
    inline-size: 100%;
    max-inline-size: none;
    block-size: 100dvh;
    max-block-size: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--c-white);
    color: var(--c-deep-blue);
    overflow-y: auto;
    opacity: 0;
    transition:
      opacity 300ms var(--ease-out),
      display 300ms allow-discrete,
      overlay 300ms allow-discrete;
  }

  .mobile-menu[open] {
    opacity: 1;
  }

  @starting-style {
    .mobile-menu[open] {
      opacity: 0;
    }
  }

  .mobile-menu::backdrop {
    background: transparent;
  }

  .mobile-menu__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    block-size: var(--header-h);
    border-block-end: 1px solid var(--c-pale-blue-grey);
  }

  .mobile-menu__close {
    display: grid;
    place-items: center;
    inline-size: var(--tap);
    block-size: var(--tap);
    border: 1px solid var(--c-pale-blue-grey);
    border-radius: var(--r-pill);
    background: var(--c-white);
  }

  .mobile-menu__body {
    padding-block: var(--space-6) var(--space-9);
  }

  .mobile-menu__primary a {
    display: block;
    padding-block: var(--space-2);
    font-size: 2rem;
    font-weight: 300;
    letter-spacing: var(--tr-h2);
    line-height: 1.25;
    text-decoration: none;
  }

  .mobile-menu__label {
    margin-block: var(--space-7) var(--space-3);
    font-size: var(--fs-eyebrow);
    font-weight: 700;
    letter-spacing: var(--tr-eyebrow);
    text-transform: uppercase;
    color: var(--c-medium-blue);
  }

  .mobile-menu__sectors {
    display: grid;
    grid-template-columns: 1fr;
    column-gap: var(--gutter);
  }

  @media (min-width: 560px) {
    .mobile-menu__sectors {
      grid-template-columns: 1fr 1fr;
    }
  }

  .mobile-menu__sectors a {
    display: flex;
    align-items: center;
    min-block-size: var(--tap);
    padding-block: var(--space-2);
    border-block-start: 1px solid var(--c-pale-blue-grey);
    font-weight: 500;
    text-decoration: none;
  }

  [aria-current] {
    color: var(--c-medium-blue);
  }

  @media (prefers-reduced-motion: no-preference) {
    .mobile-menu li,
    .mobile-menu__label {
      opacity: 0;
      transform: translateY(8px);
      transition:
        opacity 400ms var(--ease-out),
        transform 400ms var(--ease-out);
      transition-delay: calc(var(--i) * 30ms + 80ms);
    }

    .mobile-menu[open] li,
    .mobile-menu[open] .mobile-menu__label {
      opacity: 1;
      transform: none;
    }

    @starting-style {
      .mobile-menu[open] li,
      .mobile-menu[open] .mobile-menu__label {
        opacity: 0;
        transform: translateY(8px);
      }
    }
  }
</style>
