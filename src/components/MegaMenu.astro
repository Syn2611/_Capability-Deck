---
import Icon from './Icon.astro';
import type { Sector } from '../lib/sectors';
import { url, pad } from '../lib/url';

interface Props {
  sectors: Sector[];
  current?: string;
}

const { sectors, current } = Astro.props;
---

<div class="mega" id="mega-menu" data-mega hidden>
  <div class="container mega__inner">
    <div class="mega__intro">
      <p class="eyebrow">Sectors</p>
      <p class="mega__lead">Specialists across all property sectors in Australia.</p>
      <a class="link-arrow" href={url('/sectors/')}>
        <span>All sectors</span> <Icon name="arrow-right" />
      </a>
    </div>
    <ul class="mega__list" role="list">
      {sectors.map((s, i) => (
        <li>
          <a
            class="mega__item"
            href={url(`/sectors/${s.id}/`)}
            aria-current={current === s.id ? 'page' : undefined}
          >
            <span class="mega__num t-num">{pad(i + 1)}</span>
            <span class="mega__text">
              <span class="mega__title">{s.data.title}</span>
              {s.data.descriptor && <span class="mega__desc">{s.data.descriptor}</span>}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .mega {
    position: absolute;
    inset-inline: 0;
    inset-block-start: 100%;
    background: var(--c-white);
    border-block: 1px solid var(--c-pale-blue-grey);
    box-shadow: var(--shadow);
    opacity: 0;
    transform: translateY(-8px);
    transition:
      opacity 250ms var(--ease-out),
      transform 250ms var(--ease-out),
      display 250ms allow-discrete;
    max-block-size: calc(100svh - var(--header-h));
    overflow-y: auto;
  }

  .mega[data-open] {
    opacity: 1;
    transform: none;
  }

  @starting-style {
    .mega[data-open] {
      opacity: 0;
      transform: translateY(-8px);
    }
  }

  .mega__inner {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    gap: var(--gutter);
    padding-block: var(--space-7) var(--space-8);
  }

  .mega__lead {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: 1.25rem;
    line-height: 1.45;
    margin-block: var(--space-4) var(--space-5);
    max-inline-size: 22ch;
  }

  .mega__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--gutter);
    margin: 0;
  }

  .mega__item {
    display: flex;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-block-start: 1px solid var(--c-pale-blue-grey);
    text-decoration: none;
    color: var(--c-deep-blue);
    min-block-size: var(--tap);
  }

  .mega__num {
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--c-medium-blue);
    padding-block-start: 2px;
    min-inline-size: 2ch;
  }

  .mega__title {
    display: block;
    font-weight: 600;
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0 1px;
    transition: background-size var(--dur-base) var(--ease-out);
    inline-size: fit-content;
  }

  .mega__item:hover .mega__title,
  .mega__item[aria-current] .mega__title {
    background-size: 100% 1px;
  }

  .mega__desc {
    display: block;
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--c-deep-blue-grey);
    margin-block-start: 2px;
  }
</style>
