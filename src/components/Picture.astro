---
import { Picture as AstroPicture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { imageOpts } from '../lib/image-opts';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** `sizes` attribute — describe the rendered width. */
  sizes?: string;
  widths?: number[];
  /** Above-the-fold images: eager + high priority. */
  priority?: boolean;
  class?: string;
  /** Pass-through for `transition:name` on the <img>. */
  vtName?: string;
}

const { src, alt, sizes = '100vw', widths, priority = false, class: cls, vtName } = Astro.props;
const candidate = widths ?? [480, 800, 1200, 1600, 2000, 2400];
const opts = imageOpts(candidate, src.width);
---

<AstroPicture
  src={src}
  alt={alt}
  {...opts}
  sizes={sizes}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
  decoding={priority ? 'sync' : 'async'}
  class={cls}
  style={vtName ? `view-transition-name:${vtName}` : undefined}
  quality={78}
/>
