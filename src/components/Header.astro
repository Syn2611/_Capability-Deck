---
import logo from '../assets/brand/colliers-logo.svg';
import Icon from './Icon.astro';
import MegaMenu from './MegaMenu.astro';
import type { Sector } from '../lib/sectors';
import { url } from '../lib/url';

interface Props {
  sectors: Sector[];
  current?: string;
}

const { sectors, current } = Astro.props;
const path = Astro.url.pathname;
const isHome = path === url('/');
const inSectors = path.startsWith(url('/sectors/'));
const isContact = path.startsWith(url('/contact/'));

const links = [
  { label: 'Quality', href: url('/#quality') },
  { label: 'Track Record', href: url('/#track-record') },
  { label: 'Experts', href: url('/#experts') },
];
---

<header class="site-header" data-header transition:animate="none">
  <div class="container site-header__inner">
    <a href={url('/')} class="lockup" aria-label="Colliers Valuation & Advisory Services, overview">
      <img
        class="lockup__logo"
        src={logo.src}
        width="96"
        height="55"
        alt="Colliers"
        loading="eager"
        decoding="async"
      />
      <span class="lockup__rule" aria-hidden="true"></span>
      <span class="lockup__text">
        Valuation &amp; <br class="lockup__br" />
        Advisory Services
      </span>
    </a>

    <nav class="nav" aria-label="Primary">
      <ul class="nav__list" role="list">
        <li>
          <a class="nav__link" href={url('/')} aria-current={isHome ? 'page' : undefined}>
            Overview
          </a>
        </li>
        <li>
          <button
            class="nav__link nav__trigger"
            type="button"
            aria-expanded="false"
            aria-controls="mega-menu"
            data-mega-toggle
            aria-current={inSectors ? 'true' : undefined}
          >
            Sectors <Icon name="chevron-down" class="nav__chev" />
          </button>
        </li>
        {links.map((l) => (
          <li>
            <a class="nav__link" href={l.href}>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a
      class="btn btn--deep site-header__cta"
      href={url('/contact/')}
      aria-current={isContact ? 'page' : undefined}
    >
      Contact
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-haspopup="dialog"
      aria-controls="mobile-menu"
      data-menu-open
    >
      <span class="sr-only">Open menu</span>
      <Icon name="menu" />
    </button>
  </div>
  <MegaMenu sectors={sectors} current={current} />
</header>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    background: var(--frost);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-block-end: 1px solid transparent;
    transition: border-color var(--dur-base) var(--ease-out);
  }

  .site-header[data-scrolled] {
    border-block-end-color: var(--c-pale-blue-grey);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    block-size: var(--header-h);
    transition: block-size var(--dur-base) var(--ease-out);
  }

  .site-header[data-scrolled] .site-header__inner {
    block-size: var(--header-h-condensed);
  }

  .lockup {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
    text-decoration: none;
    color: var(--c-deep-blue);
    margin-inline-end: auto;
    min-block-size: var(--tap);
  }

  .lockup__logo {
    inline-size: 96px;
    block-size: auto;
  }

  .lockup__rule {
    inline-size: 1px;
    block-size: 32px;
    background: var(--c-light-blue-grey);
  }

  .lockup__text {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: var(--tr-lockup);
    line-height: 1.3;
    white-space: nowrap;
  }

  .lockup__br {
    display: none;
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin: 0;
  }

  .nav__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-block-size: var(--tap);
    padding: 0 var(--space-3);
    border: 0;
    background: none;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--c-deep-blue);
    text-decoration: none;
    border-radius: var(--r-pill);
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: var(--space-3) calc(100% - 10px);
    background-size: 0 1px;
    transition: background-size var(--dur-base) var(--ease-out);
  }

  .nav__link:hover,
  .nav__link[aria-current],
  .nav__trigger[aria-expanded='true'] {
    background-size: calc(100% - 2 * var(--space-3)) 1px;
  }

  .nav__trigger :global(.nav__chev) {
    --icon-size: 16px;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .nav__trigger[aria-expanded='true'] :global(.nav__chev) {
    transform: rotate(180deg);
  }

  .menu-toggle {
    display: none;
    place-items: center;
    inline-size: var(--tap);
    block-size: var(--tap);
    border: 1px solid var(--c-pale-blue-grey);
    border-radius: var(--r-pill);
    background: var(--c-white);
    color: var(--c-deep-blue);
  }

  @media (max-width: 1023px) {
    .nav,
    .site-header__cta {
      display: none;
    }

    .menu-toggle {
      display: grid;
    }
  }

  @media (max-width: 479px) {
    .lockup {
      gap: var(--space-3);
    }

    .lockup__br {
      display: inline;
    }

    .lockup__rule {
      block-size: 28px;
    }
  }
</style>
